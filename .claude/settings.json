{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/graph-gate.sh\"",
            "statusMessage": "Checking codebase graph...",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
